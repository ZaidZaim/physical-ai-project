# --- Neo4j Aura (domain memory: objects, locations, observations, spatial relations)
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- OpenAI (vision perception + question answering)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o

# --- NAMS hosted agent memory (optional: conversation + reasoning-trace memory)
# Create a key at https://memory.neo4jlabs.com  (prefix nams_)
NAMS_API_KEY=
NAMS_BASE_URL=https://memory.neo4jlabs.com
# Workspace id from the NAMS dashboard (sent as X-Workspace-Id)
NAMS_WORKSPACE_ID=

# --- Robot / deployment
ROBOT_NAME=PuppyPi
DEFAULT_LOCATION=Demo Area
# Camera source for `watch`: webcam:0 | http://<puppy-ip>:8080/stream?topic=/usb_cam/image_raw | folder:./frames
CAMERA_SOURCE=
WATCH_INTERVAL_S=5
# Shared secret the robot must send as X-Brain-Token when pushing frames (optional)
BRAIN_TOKEN=

# --- Perception / memory behaviour
OBJECT_VOCAB=laptop,bottle,cup,chair,table,backpack,phone,book,monitor,keyboard,plant,box
STRICT_VOCAB=false
MIN_CONFIDENCE=0.5
MISS_THRESHOLD=3

# --- Privacy (people)
# Without consent, people are stored only as anonymous "person" presence: no description, no colours, no images.
PEOPLE_CONSENT=false
STORE_IMAGES=false

# --- Spatial memory (places, orientation)
AUTO_PLACE=true
MIN_OVERLAP=0.5
PLACE_CONFIRM_FRAMES=2
# Camera horizontal field of view (degrees); a guess until measured on your robot.
CAMERA_FOV_DEG=70
