# --- Neo4j Aura (domain memory: objects, locations, observations, spatial relations)
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- OpenAI (vision perception + question answering)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o

# --- NAMS hosted agent memory (optional: conversation + reasoning-trace memory)
# Create a key at https://memory.neo4jlabs.com  (prefix nams_)
NAMS_API_KEY=
NAMS_BASE_URL=https://memory.neo4jlabs.com
# Workspace id from the NAMS dashboard (sent as X-Workspace-Id)
NAMS_WORKSPACE_ID=

# --- Robot / deployment
ROBOT_NAME=PuppyPi
DEFAULT_LOCATION=Demo Area
# Camera source for `watch`: webcam:0 | http://<puppy-ip>:8080/stream?topic=/usb_cam/image_raw | folder:./frames
CAMERA_SOURCE=
WATCH_INTERVAL_S=5
# Shared secret the robot must send as X-Brain-Token when pushing frames (optional)
BRAIN_TOKEN=

# --- Perception / memory behaviour
OBJECT_VOCAB=laptop,bottle,cup,chair,table,backpack,phone,book,monitor,keyboard,plant,box
STRICT_VOCAB=false
MIN_CONFIDENCE=0.5
MISS_THRESHOLD=3

# --- Privacy (people)
# Without consent, people are stored only as anonymous "person" presence: no description, no colours, no images.
PEOPLE_CONSENT=false
# Booth conversation (docs/PEOPLE.md). Visitors are remembered ONLY after they say yes out loud.
PEOPLE_GREET=true
GREET_COOLDOWN_S=60
# Crowd control: only people close to and facing the robot are greeted; 3+ of them get one group hello
MAX_GREETINGS_PER_HOUR=40
PERSON_REGREET_S=1800
GROUP_MIN=3
# Booth mode: the robot tilts its body slightly nose-up to see faces and badges, and greets with a trick
# (Hiwonder action group: boxing, wave, shake_hands, bow, nod; empty for none). Also switchable in the Booth tab.
BOOTH_MODE=false
LOOK_UP_DEG=10
GREET_ACTION=
# Conversations on the robot start with the wake word; follow-ups within WAKE_WINDOW_S need none (empty WAKE_WORD: always listen)
WAKE_WORD=Hey PuppyPi
WAKE_WINDOW_S=45
# On the wake word: this trick first (empty: none; boxing tipped the robot over at the booth), then look up at the visitor
# (degrees, max 30) for the conversation; IDLE when waiting.
WAKE_ACTION=
# Listen for the wake word whether or not the Booth tab is open (false: only while it is open)
LISTEN_ALWAYS=true
ENGAGED_LOOK_UP_DEG=25
IDLE_LOOK_UP_DEG=0
GESTURE_COOLDOWN_S=60
MAX_GESTURES_PER_HOUR=30
ENCOUNTER_IDLE_S=300
EVENT_NAME=the conference
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Booth language: speech is transcribed as this language and the Wizard always answers in it (en, de, fr, es, ...)
VOICE_LANGUAGE=en
# Booth conversations through OpenAI GPT-Live (about 1 s to the first sound instead of 5-7 s; billed per minute, see docs/BOOTH.md)
LIVE_VOICE=true
# Let visitors interrupt the robot while it talks (needs the robot's echo canceller; it heard itself at the booth, so off)
LIVE_BARGE_IN=false
# The robot's address for "uv run puppy-mind booth" (empty: search the network)
ROBOT_IP=
# Louder speech for the robot's small speaker (1 = as generated)
VOICE_GAIN=2.5
# The claw machine cheers (Booth tab buttons); CHEER_EVERY_S > 0 also invites people by itself every that many seconds
CLAW_MACHINE=false
CLAW_PRIZE=a Graph Wizard
CHEER_EVERY_S=0
# At a booth the place is fixed: no room guessing
# DEFAULT_LOCATION=Conference hall
# AUTO_PLACE=false
# What is on at the booth, so the Wizard can tell visitors (it never invents it), e.g.
# BOOTH_INFO=Demos: GraphRAG chatbot at table 1, Aura Agents at table 2. Talk "Graphs for physical AI" at 14:00 in Hall B.
BOOTH_INFO=
STORE_IMAGES=false

# --- Spatial memory (places, orientation)
AUTO_PLACE=true
MIN_OVERLAP=0.5
PLACE_CONFIRM_FRAMES=2
NEW_PLACE_CONFIRM_FRAMES=2
ADJACENCY_MAX_GAP_S=60
# Camera horizontal field of view (degrees); a guess until measured on your robot.
CAMERA_FOV_DEG=70

# --- Walking speed (cm/s). Level 3 ("fast") walks at DRIVE_MAX_X; level 4 ("sprint", key 4 or "run!") walks forward/back at
# DRIVE_SPRINT_X. The robot's firmware drops any command above 35 cm/s, so both are capped there. The PuppyPi cannot walk
# sideways (8 servos, no sideways hip joint).
DRIVE_MAX_X=12
DRIVE_SPRINT_X=15
# Steer straight walks back on course with the gyro. Off: at 30 cm/s the drift had no steady direction and the added turning made
# the dog nearly flip. Sprint is 15 cm/s, the top of the speed range Hiwonder tuned the walk for: measured at 20-30 cm/s, forward
# sprints veered 55-196 degrees, left on some runs and right on others.
DRIVE_HOLD_HEADING=0
