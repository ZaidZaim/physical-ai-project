{
  "message": "puppy-mind rev 2: the conference booth in POLE+O. Person (consented visitor, PII-marked, unique person_id), Organization, Topic and Event (one booth conversation) with the lead fields the Neo4j team follows up on; robot hosts conversations; booth extraction aliases live in this file",
  "validation_mode": "permissive",
  "ontology": {
    "domain": {
      "id": "puppy-pi",
      "name": "PuppyPi Physical World",
      "description": "What a quadruped robot sees and remembers: the robot, physical objects, places and the spatial relationships between them; and at a conference booth, the visitors who said yes to being remembered, the organizations they work for, the topics they care about and the conversations the robot hosted with them, so the Neo4j team can follow up",
      "tagline": "Talk with your environment"
    },
    "entity_types": [
      {
        "label": "Agent",
        "description": "The Hiwonder PuppyPi quadruped that observes and remembers.",
        "pole_type": "OBJECT",
        "subtype": "robot",
        "color": "#6366F1",
        "icon": "bot",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "agent_id",
            "type": "string",
            "required": false,
            "unique": true
          },
          {
            "name": "model",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Object",
        "description": "A physical thing the robot saw: table, laptop, chair, bottle, backpack. One entity per physically distinct instance; object_id links it to the Aura world model.",
        "pole_type": "OBJECT",
        "subtype": "physical_object",
        "color": "#4FB3FF",
        "icon": "box",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "object_id",
            "type": "string",
            "required": false
          },
          {
            "name": "label",
            "type": "string",
            "required": false
          },
          {
            "name": "color",
            "type": "string",
            "required": false
          },
          {
            "name": "first_seen",
            "type": "string",
            "required": false
          },
          {
            "name": "location",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Location",
        "description": "A named area the robot observes, e.g. Demo Area, Booth, Booth Table.",
        "pole_type": "LOCATION",
        "subtype": "place",
        "color": "#3FB950",
        "icon": "map-pin",
        "pii_sensitive": false,
        "properties": []
      },
      {
        "label": "Person",
        "description": "A conference visitor the robot talked to. Stored ONLY after the visitor said yes out loud to being remembered and followed up; never identified from camera frames. person_id is the app's id (one entity per visitor, never merged by a similar name). Carries what they told the robot and the lead fields for the Neo4j team's follow-up.",
        "pole_type": "PERSON",
        "subtype": "visitor",
        "color": "#D29922",
        "icon": "user",
        "pii_sensitive": true,
        "properties": [
          {
            "name": "person_id",
            "type": "string",
            "required": false,
            "unique": true
          },
          {
            "name": "name",
            "type": "string",
            "required": false,
            "pii": true
          },
          {
            "name": "role",
            "type": "string",
            "required": false
          },
          {
            "name": "function",
            "type": "string",
            "required": false
          },
          {
            "name": "company",
            "type": "string",
            "required": false
          },
          {
            "name": "email",
            "type": "string",
            "required": false,
            "pii": true
          },
          {
            "name": "use_case",
            "type": "string",
            "required": false
          },
          {
            "name": "familiarity",
            "type": "string",
            "required": false,
            "enum": [
              "none",
              "curious",
              "user",
              "expert"
            ]
          },
          {
            "name": "lead_score",
            "type": "integer",
            "required": false
          },
          {
            "name": "lead_stage",
            "type": "string",
            "required": false,
            "enum": [
              "cold",
              "warm",
              "hot"
            ]
          },
          {
            "name": "wants_follow_up",
            "type": "boolean",
            "required": false
          },
          {
            "name": "wants_demo",
            "type": "boolean",
            "required": false
          },
          {
            "name": "next_step",
            "type": "string",
            "required": false
          },
          {
            "name": "consent_at",
            "type": "string",
            "required": false
          },
          {
            "name": "first_met",
            "type": "string",
            "required": false
          },
          {
            "name": "last_met",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Organization",
        "description": "A company or institution a visitor works for, as they said it (shared by all its visitors).",
        "pole_type": "ORGANIZATION",
        "subtype": "company",
        "color": "#8B5CF6",
        "icon": "building",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "name",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Topic",
        "description": "A technology or theme visitors care about (GraphRAG, Aura, knowledge graphs, agent memory) or something they enjoyed at the event (a keynote, the robot demo). Shared: visitors who care about the same topic meet in it.",
        "pole_type": "OBJECT",
        "subtype": "topic",
        "color": "#14B8A6",
        "icon": "tag",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "name",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Event",
        "description": "One conversation the robot hosted at the booth with a visitor who said yes: when, at which event and place, and a one-sentence summary (never a transcript).",
        "pole_type": "EVENT",
        "subtype": "booth_conversation",
        "color": "#F97316",
        "icon": "message-circle",
        "pii_sensitive": true,
        "properties": [
          {
            "name": "event_id",
            "type": "string",
            "required": false,
            "unique": true
          },
          {
            "name": "ts",
            "type": "string",
            "required": false
          },
          {
            "name": "event_name",
            "type": "string",
            "required": false
          },
          {
            "name": "summary",
            "type": "string",
            "required": false
          }
        ]
      }
    ],
