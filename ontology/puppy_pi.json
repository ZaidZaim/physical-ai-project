{
  "message": "puppy-mind rev 3: anonymous booth. Lead generation is on hold (no personal data): Person has no lead fields and no booth relationships; Event is one anonymous booth conversation (need, familiarity, questions) that DISCUSSED and ENJOYED Topics, HOSTED by the robot",
  "validation_mode": "permissive",
  "ontology": {
    "domain": {
      "id": "puppy-pi",
      "name": "PuppyPi Physical World",
      "description": "What a quadruped robot sees and remembers: the robot, physical objects, places and the spatial relationships between them; and at a conference booth, anonymous notes of what visitors asked about, need and enjoyed (never who they are)",
      "tagline": "Talk with your environment"
    },
    "entity_types": [
      {
        "label": "Agent",
        "description": "The Hiwonder PuppyPi quadruped that observes and remembers.",
        "pole_type": "OBJECT",
        "subtype": "robot",
        "color": "#6366F1",
        "icon": "bot",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "agent_id",
            "type": "string",
            "required": false,
            "unique": true
          },
          {
            "name": "model",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Object",
        "description": "A physical thing the robot saw: table, laptop, chair, bottle, backpack. One entity per physically distinct instance; object_id links it to the Aura world model.",
        "pole_type": "OBJECT",
        "subtype": "physical_object",
        "color": "#4FB3FF",
        "icon": "box",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "object_id",
            "type": "string",
            "required": false
          },
          {
            "name": "label",
            "type": "string",
            "required": false
          },
          {
            "name": "color",
            "type": "string",
            "required": false
          },
          {
            "name": "first_seen",
            "type": "string",
            "required": false
          },
          {
            "name": "location",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Location",
        "description": "A named area the robot observes, e.g. Demo Area, Booth, Booth Table.",
        "pole_type": "LOCATION",
        "subtype": "place",
        "color": "#3FB950",
        "icon": "map-pin",
        "pii_sensitive": false,
        "properties": []
      },
      {
        "label": "Person",
        "description": "A person mentioned in text or seen by the camera. This app never stores visitors as people: booth conversations are anonymous (see Event).",
        "pole_type": "PERSON",
        "subtype": "person",
        "color": "#D29922",
        "icon": "user",
        "pii_sensitive": true,
        "properties": []
      },
      {
        "label": "Organization",
        "description": "A company or institution mentioned in conversation (never linked to a visitor).",
        "pole_type": "ORGANIZATION",
        "subtype": "company",
        "color": "#8B5CF6",
        "icon": "building",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "name",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Topic",
        "description": "A technology or theme raised at the booth (GraphRAG, Aura, knowledge graphs, agent memory) or something visitors enjoyed at the event (a keynote, the robot demo). Shared across conversations.",
        "pole_type": "OBJECT",
        "subtype": "topic",
        "color": "#14B8A6",
        "icon": "tag",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "name",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Event",
        "description": "One anonymous conversation the robot hosted at the booth: when, at which event, what the visitor needs and asked, and how well they know Neo4j. Never who they are.",
        "pole_type": "EVENT",
        "subtype": "booth_conversation",
        "color": "#F97316",
        "icon": "message-circle",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "event_id",
            "type": "string",
            "required": false,
            "unique": true
          },
          {
            "name": "ts",
            "type": "string",
            "required": false
          },
          {
            "name": "event_name",
            "type": "string",
            "required": false
          },
          {
            "name": "need",
            "type": "string",
            "required": false
          },
          {
            "name": "familiarity",
            "type": "string",
            "required": false,
            "enum": [
              "none",
              "curious",
              "user",
              "expert"
            ]
          },
          {
            "name": "questions",
            "type": "string",
            "required": false
          },
          {
            "name": "summary",
            "type": "string",
            "required": false
          },
          {
            "name": "turns",
            "type": "integer",
            "required": false
          }
        ]
      }
