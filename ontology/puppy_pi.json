{
  "message": "puppy-mind: physical-world vocabulary (Agent=robot, Location, Object, Person) with spatial relationships; extends the agent-memory ontology",
  "validation_mode": "permissive",
  "ontology": {
    "domain": {
      "id": "puppy-pi",
      "name": "PuppyPi Physical World",
      "description": "What a quadruped robot sees and remembers: the robot, physical objects, places, consenting people, and the spatial relationships between them",
      "tagline": "Talk with your environment"
    },
    "entity_types": [
      {
        "label": "Agent",
        "description": "The Hiwonder PuppyPi quadruped that observes and remembers.",
        "pole_type": "OBJECT",
        "subtype": "robot",
        "color": "#6366F1",
        "icon": "bot",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "model",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Object",
        "description": "A physical thing the robot saw: table, laptop, chair, bottle, backpack. One entity per physically distinct instance; object_id links it to the Aura world model.",
        "pole_type": "OBJECT",
        "subtype": "physical_object",
        "color": "#4FB3FF",
        "icon": "box",
        "pii_sensitive": false,
        "properties": [
          {
            "name": "object_id",
            "type": "string",
            "required": false
          },
          {
            "name": "label",
            "type": "string",
            "required": false
          },
          {
            "name": "color",
            "type": "string",
            "required": false
          },
          {
            "name": "first_seen",
            "type": "string",
            "required": false
          },
          {
            "name": "location",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "label": "Location",
        "description": "A named area the robot observes, e.g. Demo Area, Booth, Booth Table.",
        "pole_type": "LOCATION",
        "subtype": "place",
        "color": "#3FB950",
        "icon": "map-pin",
        "pii_sensitive": false,
        "properties": []
      },
      {
        "label": "Person",
        "description": "A visitor. Stored ONLY with explicit consent; never identified from camera frames.",
        "pole_type": "PERSON",
        "subtype": "visitor",
        "color": "#D29922",
        "icon": "user",
        "pii_sensitive": true,
        "properties": []
      }
    ],
    "extraction_aliases": {},
    "relationships": [
      {
        "type": "ON",
        "source": "Object",
        "target": "Object",
        "description": "Resting on top of"
      },
      {
        "type": "INSIDE",
        "source": "Object",
        "target": "Object",
        "description": "Contained in"
      },
      {
        "type": "NEXT_TO",
        "source": "Object",
        "target": "Object",
        "description": "Side by side"
      },
      {
        "type": "NEAR",
        "source": "Object",
        "target": "Object",
        "description": "Close to, not touching"
      },
      {
        "type": "IN_FRONT_OF",
        "source": "Object",
        "target": "Object",
        "description": "In front of, from the robot's view"
      },
      {
        "type": "BEHIND",
        "source": "Object",
        "target": "Object",
        "description": "Behind, from the robot's view"
      },
      {
        "type": "LOCATED_AT",
        "source": "Object",
        "target": "Location",
        "description": "Seen at this place"
      },
      {
        "type": "OBSERVED",
        "source": "Agent",
        "target": "Object",
        "description": "The robot saw it (confidence = detection confidence)"
      },
      {
        "type": "VISITED",
        "source": "Agent",
        "target": "Location",
        "description": "The robot was at this place"
      },
      {
        "type": "INTERACTED_WITH",
        "source": "Agent",
        "target": "Person",
        "description": "Consented interaction"
      }
    ]
  }
}
